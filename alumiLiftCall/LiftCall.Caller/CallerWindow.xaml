<Window
    x:Class="LiftCall.Caller.CallerWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="リフト呼び出し"
    Width="1344"
    Height="756"
    FontFamily="Yu Gothic UI, Meiryo UI, Segoe UI"
    WindowStartupLocation="CenterScreen">

    <Window.Resources>

        <!--  ===== 色定義 =====  -->
        <Color x:Key="NavyColor">#1E3A5F</Color>
        <SolidColorBrush x:Key="NavyBrush" Color="{StaticResource NavyColor}" />
        <SolidColorBrush x:Key="GreenBrush" Color="#16A34A" />
        <SolidColorBrush x:Key="OrangeBrush" Color="#F28C0F" />
        <SolidColorBrush x:Key="RedBrush" Color="#E53935" />
        <SolidColorBrush x:Key="GrayBrush" Color="#6B7280" />
        <SolidColorBrush x:Key="BlueBrush" Color="#2563EB" />

        <!--  ===== 背景（明るい水色グラデーション） =====  -->
        <LinearGradientBrush x:Key="WindowBackground" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Offset="0" Color="#F4F9FF" />
            <GradientStop Offset="1" Color="#CFE4FA" />
        </LinearGradientBrush>

        <!--  ===== 共通ボタンスタイル =====  -->
        <Style x:Key="BigButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="12" />
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="1" ScaleY="1" />
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="#33FFFFFF"
                            BorderThickness="3"
                            CornerRadius="24">
                            <Border.Effect>
                                <DropShadowEffect
                                    BlurRadius="20"
                                    Direction="270"
                                    Opacity="0.30"
                                    ShadowDepth="6"
                                    Color="#000000" />
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="White" />
                                <Setter TargetName="Bd" Property="Opacity" Value="0.92" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.97" ScaleY="0.97" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  ===== 状態ラベル用 =====  -->
        <Style x:Key="StatusCaptionStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="30" />
            <Setter Property="Foreground" Value="#64748B" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>

        <Style x:Key="StatusValueStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="64" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="StatusCardStyle" TargetType="Border">
            <Setter Property="Background" Value="White" />
            <Setter Property="CornerRadius" Value="20" />
            <Setter Property="BorderBrush" Value="#B6D0EE" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="Margin" Value="12" />
            <Setter Property="Padding" Value="20" />
        </Style>

        <!--  ===== パレット選択トグル（A/B/C のうち1つだけ選択） =====  -->
        <Style x:Key="PaletteToggleStyle" TargetType="ToggleButton">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="40" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{StaticResource NavyBrush}" />
            <Setter Property="Margin" Value="12,6" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border
                            x:Name="Bd"
                            Background="White"
                            BorderBrush="#94A3B8"
                            BorderThickness="3"
                            CornerRadius="18">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource BlueBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource BlueBrush}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#93C5FD" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Grid Background="{StaticResource WindowBackground}">
        <Grid Margin="24">
            <!--  ===== メインカード =====  -->
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="4*" />
                    <RowDefinition Height="1.5*" />
                    <RowDefinition Height="3.6*" />
                    <RowDefinition Height="1.3*" />
                </Grid.RowDefinitions>

                <!--  ===== ヘッダー＋ステータス =====  -->
                <Border
                    Grid.Row="0"
                    Margin="5"
                    Padding="2"
                    Background="{StaticResource NavyBrush}"
                    CornerRadius="28">
                    <Border.Effect>
                        <DropShadowEffect
                            BlurRadius="20"
                            Direction="270"
                            Opacity="0.25"
                            ShadowDepth="6"
                            Color="#000000" />
                    </Border.Effect>

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!--  タイトル  -->
                        <StackPanel
                            Grid.Row="0"
                            Margin="0,8,0,0"
                            HorizontalAlignment="Center"
                            Orientation="Horizontal">
                            <TextBlock
                                Margin="0,0,24,0"
                                VerticalAlignment="Center"
                                FontFamily="Segoe UI Emoji"
                                FontSize="80"
                                Text="🚜"  Foreground="White"/>
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="80"
                                FontWeight="Bold"
                                Foreground="White"
                                Text="リフト呼び出し" />
                            <!--  号機名  -->
                            <TextBlock
                                x:Name="LiftNameText"
                                Grid.Row="1"
                                Margin="60,15,0,0"
                                HorizontalAlignment="Center"
                                FontSize="60"
                                FontWeight="Bold"
                                Foreground="#7DD3FC"
                                Text="１号機" />

                        </StackPanel>


                        <!--  ステータス2枚  -->
                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!--  リフト状態  -->
                            <Border Grid.Column="0" Style="{StaticResource StatusCardStyle}">
                                <StackPanel VerticalAlignment="Center">

                                    <StackPanel
                                        Margin="0,8,0,0"
                                        HorizontalAlignment="Center"
                                        Orientation="Horizontal">
                                        <Ellipse
                                            x:Name="LiftStateDot"
                                            Width="36"
                                            Height="36"
                                            Margin="0,0,16,0"
                                            VerticalAlignment="Center"
                                            Fill="{StaticResource GreenBrush}" />
                                        <TextBlock
                                            x:Name="LiftStateText"
                                            Foreground="{StaticResource GreenBrush}"
                                            Style="{StaticResource StatusValueStyle}"
                                            Text="運転中" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!--  応答状態  -->
                            <Border Grid.Column="1" Style="{StaticResource StatusCardStyle}">
                                <StackPanel VerticalAlignment="Center">

                                    <StackPanel
                                        Margin="0,8,0,0"
                                        HorizontalAlignment="Center"
                                        Orientation="Horizontal">
                                        <Ellipse
                                            x:Name="ResponseStateDot"
                                            Width="36"
                                            Height="36"
                                            Margin="0,0,16,0"
                                            VerticalAlignment="Center"
                                            Fill="{StaticResource BlueBrush}" />
                                        <TextBlock
                                            x:Name="ResponseStateText"
                                            Foreground="{StaticResource BlueBrush}"
                                            Style="{StaticResource StatusValueStyle}"
                                            Text="応答中" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Grid>
                </Border>

                <!--  ===== パレット選択（製品引取の前に1つ選択） =====  -->
                <Grid Grid.Row="1" Margin="5,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock
                        Grid.Column="0"
                        Margin="16,0,12,0"
                        VerticalAlignment="Center"
                        FontSize="34"
                        FontWeight="Bold"
                        Foreground="{StaticResource NavyBrush}"
                        Text="パレット選択" />

                    <ToggleButton
                        x:Name="PaletteA"
                        Grid.Column="1"
                        Click="Palette_Click"
                        Content="パレットＡ"
                        Style="{StaticResource PaletteToggleStyle}"
                        Tag="A" />
                    <ToggleButton
                        x:Name="PaletteB"
                        Grid.Column="2"
                        Click="Palette_Click"
                        Content="パレットＢ"
                        Style="{StaticResource PaletteToggleStyle}"
                        Tag="B" />
                    <ToggleButton
                        x:Name="PaletteC"
                        Grid.Column="3"
                        Click="Palette_Click"
                        Content="パレットＣ"
                        Style="{StaticResource PaletteToggleStyle}"
                        Tag="C" />
                </Grid>

                <!--  ===== 操作ボタン3つ =====  -->
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!--  製品引取（緑）  -->
                    <Button
                        x:Name="ProductButton"
                        Grid.Column="0"
                        Background="{StaticResource GreenBrush}"
                        Click="ProductPickup_Click"
                        Style="{StaticResource BigButtonStyle}">
                        <StackPanel>
                            <TextBlock
                                HorizontalAlignment="Center"
                                FontFamily="Segoe UI Emoji"
                                FontSize="80"
                                Text="📦" />
                            <TextBlock
                                Margin="0,12,0,0"
                                HorizontalAlignment="Center"
                                FontSize="64"
                                FontWeight="Bold"
                                Foreground="White"
                                Text="製品引取" />
                        </StackPanel>
                    </Button>

                    <!--  戻材引取（オレンジ）  -->
                    <Button
                        Grid.Column="1"
                        Background="{StaticResource OrangeBrush}"
                        Click="ReturnMaterial_Click"
                        Style="{StaticResource BigButtonStyle}">
                        <StackPanel>
                            <TextBlock
                                HorizontalAlignment="Center"
                                FontFamily="Segoe UI Emoji"
                                FontSize="80"
                                Text="🔄" />
                            <TextBlock
                                Margin="0,12,0,0"
                                HorizontalAlignment="Center"
                                FontSize="64"
                                FontWeight="Bold"
                                Foreground="White"
                                Text="戻材引取" />
                        </StackPanel>
                    </Button>

                    <!--  トラブル（赤）  -->
                    <Button
                        Grid.Column="2"
                        Background="{StaticResource RedBrush}"
                        Click="Trouble_Click"
                        Style="{StaticResource BigButtonStyle}">
                        <StackPanel>
                            <TextBlock
                                HorizontalAlignment="Center"
                                FontFamily="Segoe UI Emoji"
                                FontSize="80"
                                Text="⚠️" />
                            <TextBlock
                                Margin="0,12,0,0"
                                HorizontalAlignment="Center"
                                FontSize="64"
                                FontWeight="Bold"
                                Foreground="White"
                                Text="トラブル" />
                        </StackPanel>
                    </Button>
                </Grid>

                <!--  ===== キャンセル（グレー） =====  -->
                <Button
                    Grid.Row="3"
                    Background="{StaticResource GrayBrush}"
                    Click="CancelCall_Click"
                    Style="{StaticResource BigButtonStyle}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock
                            Margin="0,0,24,0"
                            VerticalAlignment="Center"
                            FontFamily="Segoe UI Emoji"
                            FontSize="44"
                            Text="❌" />
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="44"
                            FontWeight="Bold"
                            Foreground="White"
                            Text="キャンセル" />
                    </StackPanel>
                </Button>
            </Grid>
        </Grid>
    </Grid>
</Window>
