@page "/receiver"
@layout IMIP.TochuForkLift.WebApp.Layout.MainLayout
@implements IAsyncDisposable
@inject AuthStateService Auth
@inject StateSyncService Sync
@inject ForkLiftApiClient Api
@inject AlertSoundService Sound
@inject NavigationManager Nav
@inject Localizer Loc

@if (_identity is not null)
{
    <div class="kiosk-page">
        <div class="kiosk-header">
            <div class="kiosk-title">@Icons.Lift<span>@Loc["AppTitle"] — @_identity.Name</span></div>
            <div class="kiosk-header-right">
                <LanguageSwitcher />
                <span class="kiosk-clock">@_now.ToString("HH:mm:ss")</span>
            </div>
        </div>

        <LiftToggle IsRunning="@MyLiftIsRunning" OnToggle="OnLiftToggle" />

        <CallList Calls="@VisibleCalls" Now="@_now" IsLiftRunning="@MyLiftIsRunning"
                  OnRespond="OnRespond" OnComplete="OnComplete" OnRelease="OnRelease" />

        <Toast Message="@_toast" />
        <ConnectionErrorOverlay Visible="@(!IsConnected)" />

        <div class="kiosk-footer">
            <button type="button" class="kiosk-change-device" @onclick="ChangeDevice">@Loc["ChangeDevice"]</button>
        </div>
    </div>
}

@code {
    private TerminalIdentity? _identity;
    private string? _toast;
    private DateTime _now = DateTime.UtcNow;
    private PeriodicTimer? _clock;
    private Task? _clockLoop;
    private PeriodicTimer? _validityTimer;
    private Task? _validityLoop;

    // Optimistic client-side hide while waiting for the next snapshot after losing a claim race (plan.md §6.4).
    private readonly HashSet<int> _locallyHidden = [];

    // Each Receiver terminal is its own independent lift — this terminal only cares about its own
    // running/stopped state (Caller screens separately show the OR across every lift).
    private bool MyLiftIsRunning => Sync.Snapshot.LiftStates
        .FirstOrDefault(l => l.TerminalId == _identity?.TerminalId)?.IsRunning ?? false;

    // A call claimed by another Receiver is simply absent here, not shown disabled (plan.md §6.4).
    // Order: Responding calls before waiting ones; within each group, Trouble first, then FIFO —
    // by RespondedAt (claim order) for the Responding group, by CalledAt (arrival order) for Waiting.
    private List<CallDto> VisibleCalls => Sync.Snapshot.Calls
        .Where(c => (!c.IsResponding || c.RespondedBy == _identity?.Name) && !_locallyHidden.Contains(c.UnitNo))
        .OrderByDescending(c => c.IsResponding)
        .ThenByDescending(c => c.CallType == CallType.Trouble)
        .ThenBy(c => c.IsResponding ? (c.RespondedAt ?? c.CalledAt) : c.CalledAt)
        .ToList();

    private bool IsConnected => Sync.ConnectionState is Microsoft.AspNetCore.SignalR.Client.HubConnectionState.Connected;

    protected override async Task OnInitializedAsync()
    {
        await Auth.LoadAsync();
        if (Auth.Current is not { Role: TerminalRole.Receiver })
        {
            Nav.NavigateTo("/");
            return;
        }
        _identity = Auth.Current;

        if (!await Auth.ValidateAsync())
        {
            Nav.NavigateTo("/");
            return;
        }

        await Sync.InitializeAsync(_identity.TerminalId);
        Sync.Updated += OnSyncUpdated;
        Sync.ConnectionStateChanged += OnSyncUpdated;
        Loc.LanguageChanged += OnLanguageChanged;

        _clock = new PeriodicTimer(TimeSpan.FromSeconds(1));
        _clockLoop = ClockLoopAsync();

        _validityTimer = new PeriodicTimer(TimeSpan.FromSeconds(30));
        _validityLoop = ValidityLoopAsync();
    }

    private async Task ClockLoopAsync()
    {
        try
        {
            while (await _clock!.WaitForNextTickAsync())
            {
                _now = DateTime.UtcNow;
                StateHasChanged();
            }
        }
        catch (ObjectDisposedException) { }
    }

    // Catches Admin deleting/deactivating this terminal while the tablet is already sitting on this
    // screen — without this, a stale cached identity would just keep working silently forever.
    private async Task ValidityLoopAsync()
    {
        try
        {
            while (await _validityTimer!.WaitForNextTickAsync())
            {
                if (!await Auth.ValidateAsync())
                {
                    Nav.NavigateTo("/", forceLoad: true);
                    return;
                }
            }
        }
        catch (ObjectDisposedException) { }
    }

    private void OnSyncUpdated()
    {
        // Snapshot is authoritative again — drop any optimistic hides from the last claim race.
        _locallyHidden.Clear();
        InvokeAsync(StateHasChanged);
    }

    private void OnLanguageChanged() => InvokeAsync(StateHasChanged);

    // Buttons that trigger these are hidden while the lift is stopped, but guard here too in case a
    // tap lands right as the lift state flips (plan.md §6.4 + operator request: no action while stopped).
    private bool CanAct => MyLiftIsRunning;

    private async Task OnRespond(int unitNo)
    {
        if (_identity is null || !CanAct) return;
        var result = await Api.SetRespondingAsync(unitNo, new SetRespondingRequest { IsResponding = true, RespondedBy = _identity.Name });
        if (result.Outcome == ApiCallOutcome.Conflict)
        {
            _locallyHidden.Add(unitNo);
            await ShowToastAsync(Loc["ToastRespondConflict"]);
        }
    }

    private async Task OnComplete(int unitNo)
    {
        if (_identity is null || !CanAct) return;
        await Api.CompleteCallAsync(unitNo, new CompleteCallRequest { CompletedBy = _identity.Name });
    }

    private async Task OnRelease(int unitNo)
    {
        if (!CanAct) return;
        await Api.SetRespondingAsync(unitNo, new SetRespondingRequest { IsResponding = false });
    }

    private async Task OnLiftToggle(bool running)
    {
        if (_identity is null) return;
        await Api.SetLiftStateAsync(new SetLiftStateRequest { TerminalId = _identity.TerminalId, IsRunning = running, UpdatedBy = _identity.Name });
    }

    private async Task ShowToastAsync(string message)
    {
        _toast = message;
        StateHasChanged();
        await Task.Delay(2500);
        _toast = null;
        StateHasChanged();
    }

    private async Task ChangeDevice()
    {
        await Auth.ClearAsync();
        Nav.NavigateTo("/", forceLoad: true);
    }

    public async ValueTask DisposeAsync()
    {
        Sync.Updated -= OnSyncUpdated;
        Sync.ConnectionStateChanged -= OnSyncUpdated;
        Loc.LanguageChanged -= OnLanguageChanged;
        _clock?.Dispose();
        if (_clockLoop is not null) { try { await _clockLoop; } catch { } }
        _validityTimer?.Dispose();
        if (_validityLoop is not null) { try { await _validityLoop; } catch { } }
    }
}
