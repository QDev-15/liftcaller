@page "/"
@layout IMIP.TochuForkLift.WebApp.Layout.MainLayout
@implements IDisposable
@inject ForkLiftApiClient Api
@inject AuthStateService Auth
@inject NavigationManager Nav
@inject Localizer Loc

<div class="login-page">
    <LanguageSwitcher />
    <div class="login-brand">@Icons.Lift<span>@Loc["AppTitle"].ToUpperInvariant()</span></div>

    <div class="login-card">
        <div>
            <NameInput @bind-Value="_name" />
        </div>

        @if (!string.IsNullOrWhiteSpace(_name))
        {
            <div>
                <span class="login-label">@Loc["LoginPinLabel"]</span>
                <PinPad @ref="_pinPad" OnComplete="OnPinComplete" />
            </div>
        }

        @if (_errorKey is not null)
        {
            <div class="login-error">@Loc[_errorKey]</div>
        }
    </div>
</div>

@if (_showAlreadyOnline)
{
    <div class="modal-backdrop" @onclick="() => _showAlreadyOnline = false">
        <div class="modal-card" @onclick:stopPropagation="true">
            <h3>@Loc["LoginAlreadyOnlineTitle"]</h3>
            <p>@Loc["LoginAlreadyOnline"]</p>
            <div class="modal-actions">
                <button type="button" class="btn-solid" @onclick="() => _showAlreadyOnline = false">@Loc["Close"]</button>
            </div>
        </div>
    </div>
}

@code {
    private string _name = "";
    private string? _errorKey;
    private bool _showAlreadyOnline;
    private PinPad? _pinPad;
    private bool _submitting;

    protected override async Task OnInitializedAsync()
    {
        Loc.LanguageChanged += OnLanguageChanged;

        await Auth.LoadAsync();
        if (Auth.Current is not null)
        {
            RedirectForRole(Auth.Current.Role);
        }
    }

    private void OnLanguageChanged() => InvokeAsync(StateHasChanged);

    private async Task OnPinComplete(string pin)
    {
        if (_submitting) return;
        _submitting = true;
        _errorKey = null;
        _showAlreadyOnline = false;

        try
        {
            var result = await Api.LoginAsync(new LoginRequest { Name = _name.Trim(), Pin = pin });
            if (result.Outcome == ApiCallOutcome.Conflict)
            {
                _showAlreadyOnline = true;
                _pinPad?.Reset();
                return;
            }
            if (result.Outcome != ApiCallOutcome.Success || result.Response is null)
            {
                _errorKey = "LoginError";
                _pinPad?.Reset();
                return;
            }

            var response = result.Response;
            await Auth.SetAsync(new TerminalIdentity
            {
                TerminalId = response.TerminalId,
                Name = response.Name,
                Role = response.Role,
                UnitNo = response.UnitNo
            });

            RedirectForRole(response.Role);
        }
        catch
        {
            _errorKey = "LoginConnError";
            _pinPad?.Reset();
        }
        finally
        {
            _submitting = false;
        }
    }

    private void RedirectForRole(TerminalRole role) =>
        Nav.NavigateTo(role == TerminalRole.Caller ? "/caller" : "/receiver");

    public void Dispose() => Loc.LanguageChanged -= OnLanguageChanged;
}
