@page "/caller"
@layout IMIP.TochuForkLift.WebApp.Layout.MainLayout
@implements IAsyncDisposable
@inject AuthStateService Auth
@inject StateSyncService Sync
@inject ForkLiftApiClient Api
@inject NavigationManager Nav

@if (_identity is not null)
{
    <div class="kiosk-page">
        <StatusHeader UnitNo="@_identity.UnitNo!.Value" LiftRunning="@Sync.Snapshot.LiftState.IsRunning" ActiveCall="@ActiveCall" Now="@_now" />

        <CallButtons ActiveCall="@ActiveCall" OnCall="OnCall" />

        <CancelButton ActiveCall="@ActiveCall" OnCancel="OnCancel" />

        <button type="button" class="kiosk-change-device" @onclick="ChangeDevice">Đổi máy</button>

        <Toast Message="@_toast" />
        <ConnectionErrorOverlay Visible="@(!IsConnected)" />
    </div>
}

@code {
    private TerminalIdentity? _identity;
    private string? _toast;
    private DateTime _now = DateTime.Now;
    private PeriodicTimer? _clock;
    private Task? _clockLoop;

    private CallDto? ActiveCall => _identity is null
        ? null
        : Sync.Snapshot.Calls.FirstOrDefault(c => c.UnitNo == _identity.UnitNo);

    private bool IsConnected => Sync.ConnectionState is Microsoft.AspNetCore.SignalR.Client.HubConnectionState.Connected;

    protected override async Task OnInitializedAsync()
    {
        await Auth.LoadAsync();
        if (Auth.Current is not { Role: TerminalRole.Caller, UnitNo: not null })
        {
            Nav.NavigateTo("/");
            return;
        }
        _identity = Auth.Current;

        await Sync.InitializeAsync();
        Sync.Updated += OnSyncUpdated;
        Sync.ConnectionStateChanged += OnSyncUpdated;

        _clock = new PeriodicTimer(TimeSpan.FromSeconds(1));
        _clockLoop = ClockLoopAsync();
    }

    private async Task ClockLoopAsync()
    {
        try
        {
            while (await _clock!.WaitForNextTickAsync())
            {
                _now = DateTime.Now;
                StateHasChanged();
            }
        }
        catch (ObjectDisposedException) { }
    }

    private void OnSyncUpdated() => InvokeAsync(StateHasChanged);

    private async Task OnCall(CallType type)
    {
        if (_identity is null) return;

        // No pallet concept in the approved web design (prototype's call grid is just the 3 call
        // types) — Palette stays in the data model for alumiLiftCall-DDL compatibility, but the web
        // UI never collects one, so it's always sent as None.
        var result = await Api.PutCallAsync(_identity.UnitNo!.Value, new PutCallRequest { CallType = type, Palette = PaletteType.None });
        if (result.Outcome == ApiCallOutcome.Conflict)
        {
            await ShowToastAsync("Lift đang xử lý cuộc gọi của bạn, không thể gọi lại.");
        }
    }

    private async Task OnCancel()
    {
        if (_identity is null) return;
        await Api.CancelCallAsync(_identity.UnitNo!.Value);
    }

    private async Task ShowToastAsync(string message)
    {
        _toast = message;
        StateHasChanged();
        await Task.Delay(2500);
        _toast = null;
        StateHasChanged();
    }

    private async Task ChangeDevice()
    {
        await Auth.ClearAsync();
        Nav.NavigateTo("/", forceLoad: true);
    }

    public async ValueTask DisposeAsync()
    {
        Sync.Updated -= OnSyncUpdated;
        Sync.ConnectionStateChanged -= OnSyncUpdated;
        _clock?.Dispose();
        if (_clockLoop is not null) { try { await _clockLoop; } catch { } }
    }
}
