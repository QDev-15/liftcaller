@* "Đang xử lý" — only calls claimed by THIS Receiver's own TerminalIdentity.Name. Calls claimed by
   another Receiver are simply absent here, not disabled — see plan.md §6.4. *@

@if (Calls.Count > 0)
{
    <div class="progress-section">
        <h3 class="section-title">Đang xử lý</h3>
        <div class="progress-list">
            @foreach (var call in Calls)
            {
                <CallCard Call="@call" InProgress="true" Now="@Now"
                          ShowComplete="true" OnComplete="() => OnComplete.InvokeAsync(call.UnitNo)"
                          ShowRelease="true" OnRelease="() => OnRelease.InvokeAsync(call.UnitNo)" />
            }
        </div>
    </div>
}

@code {
    [Parameter, EditorRequired] public List<CallDto> Calls { get; set; } = [];
    [Parameter] public DateTime Now { get; set; } = DateTime.UtcNow;
    [Parameter] public EventCallback<int> OnComplete { get; set; }
    [Parameter] public EventCallback<int> OnRelease { get; set; }
}
