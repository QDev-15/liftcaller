@* Shared between Caller and Receiver — plan.md §4.3. Shown while the SignalR hub is disconnected. *@
@inherits LocalizedComponentBase

@if (Visible)
{
    <div class="overlay">
        <div class="overlay-icon">@Icons.Warn</div>
        <p class="overlay-title">@Loc["ConnectionErrorTitle"]</p>
        <p class="overlay-text">@Loc["ConnectionErrorText"]</p>
        <p class="overlay-hint">@Loc["ConnectionErrorHint"]</p>
    </div>
}

@code {
    [Parameter] public bool Visible { get; set; }
}
