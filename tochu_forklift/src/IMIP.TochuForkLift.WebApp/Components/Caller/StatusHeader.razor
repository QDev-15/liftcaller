@* Header + status row — ported from the prototype's caller screen (plan.md §6.3). *@
@inherits LocalizedComponentBase

<div class="kiosk-header">
    <div class="kiosk-title">@Icons.Lift<span>@Loc["AppTitle"]</span></div>
    <div class="kiosk-header-right">
        <LanguageSwitcher />
        <span class="kiosk-clock">@Now.ToString("HH:mm:ss")</span>
    </div>
</div>
<div class="kiosk-machine">@Loc.Format("MachineLabel", UnitNo)</div>

<div class="status-row">
    <div class="status-box">
        <span class="status-label">@Loc["LiftStatusLabel"]</span>
        <span class="status-value">
            <span class="dot @(LiftRunning ? "ok" : "bad")"></span>@(LiftRunning ? Loc["Running"] : Loc["Stopped"])
        </span>
    </div>
    <div class="status-box">
        <span class="status-label">@Loc["ResponseStatusLabel"]</span>
        <span class="status-value">
            <span class="dot @StatusDotClass"></span>@StatusText
        </span>
    </div>
</div>

@if (!LiftRunning)
{
    <div class="stopped-banner">@Icons.Warn<span>@Loc["StoppedBanner"]</span></div>
}

@code {
    [Parameter] public int UnitNo { get; set; }
    [Parameter] public bool LiftRunning { get; set; }
    [Parameter] public CallDto? ActiveCall { get; set; }
    [Parameter] public DateTime Now { get; set; } = DateTime.Now;

    private string StatusDotClass => ActiveCall switch
    {
        null => "idle",
        { IsResponding: true } => "info",
        _ => "warn"
    };

    private string StatusText => ActiveCall switch
    {
        null => Loc["Idle"],
        { IsResponding: true } => Loc["Responding"],
        _ => Loc["Calling"]
    };
}
