@* Cancel Call — confirms first if the lift is already responding, to match the original proposal's requirement. *@
@inherits LocalizedComponentBase

<button type="button" class="cancel-btn" disabled="@(ActiveCall is null)" @onclick="RequestCancel">
    @Icons.X<span>@Loc["CancelCall"]</span>
</button>

@if (_confirming)
{
    <div class="modal-backdrop" @onclick="() => _confirming = false">
        <div class="modal-card" @onclick:stopPropagation="true">
            <h3>@Loc["ConfirmCancelTitle"]</h3>
            <p>@Loc["ConfirmCancelBody"]</p>
            <div class="modal-actions">
                <button type="button" class="btn-ghost" @onclick="() => _confirming = false">@Loc["Close"]</button>
                <button type="button" class="btn-solid danger" @onclick="ConfirmCancel">@Loc["CancelCall"]</button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public CallDto? ActiveCall { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }

    private bool _confirming;

    private async Task RequestCancel()
    {
        if (ActiveCall is null) return;
        if (ActiveCall.IsResponding)
        {
            _confirming = true;
        }
        else
        {
            await OnCancel.InvokeAsync();
        }
    }

    private async Task ConfirmCancel()
    {
        _confirming = false;
        await OnCancel.InvokeAsync();
    }
}
