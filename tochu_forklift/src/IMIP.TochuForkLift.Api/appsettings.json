{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "EnableSwagger": true,

  // Origins allowed to call this Api from a browser (WebApp's own site/port — Admin calls over
  // plain server-to-server HttpClient, which isn't subject to CORS, so it doesn't need to be here).
  "Cors": {
    "AllowedOrigins": [ "http://localhost:6001", "http://localhost:7000" ]
  },

  

  "SignalLight": {
    "Enabled": false,
    "Host": "192.168.55.7",
    "TimeoutSeconds": 2
  },

  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/api-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30
        }
      }
    ]
  }
}
