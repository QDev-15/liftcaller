{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  // Server-to-server call to the Api app's real IIS binding — must match whatever port/host Api is
  // actually bound to (see deploy\Setup-Iis.ps1 / the site's binding in IIS Manager).
  "ApiBaseUrl": "http://localhost:5000/",

  "AdminAuth": {
    "Username": "admin",
    "PasswordHash": ""
  },

  "Localization": {
    "DefaultLanguage": "en"
  }
}
