@* Create/edit a Terminal — PIN is entered by the Admin, defaulted to "0000" (plan.md §5.1). *@
@inject ForkLiftApiClient Api
@inject Localizer Loc

@if (Show)
{
    <div class="modal-backdrop">
        <div class="modal-card">
            <h2>@(_editingId is null ? Loc["CreateTerminalTitle"] : Loc["EditTerminalTitle"])</h2>

            <div class="form-row">
                <label class="form-label">@Loc["ColName"]</label>
                <input class="form-control" @bind="_name" />
            </div>

            @if (_editingId is null)
            {
                <div class="form-row">
                    <label class="form-label">@Loc["ColRole"]</label>
                    <select class="form-control" @bind="_role">
                        <option value="@TerminalRole.Caller">@Loc["RoleCaller"]</option>
                        <option value="@TerminalRole.Receiver">@Loc["RoleReceiver"]</option>
                    </select>
                </div>
            }

            @if (_role == TerminalRole.Caller)
            {
                <div class="form-row">
                    <label class="form-label">@Loc["UnitNoLabel"]</label>
                    <input class="form-control" type="number" @bind="_unitNo" />
                </div>
            }

            <div class="form-row">
                <label class="form-label">@(_editingId is null ? Loc["PinLabel"] : Loc["NewPinLabel"])</label>
                <input class="form-control" maxlength="4" @bind="_pin" placeholder="0000" />
            </div>

            @if (_editingId is not null)
            {
                <div class="form-row">
                    <label class="form-label"><input type="checkbox" @bind="_isActive" /> @Loc["Active"]</label>
                </div>
            }

            @if (!string.IsNullOrEmpty(_error))
            {
                <div class="form-error">@_error</div>
            }

            <div class="modal-actions">
                <button type="button" class="btn" @onclick="Cancel">@Loc["Close"]</button>
                <button type="button" class="btn btn-primary" @onclick="Save">@Loc["Save"]</button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public bool Show { get; set; }
    [Parameter] public EventCallback OnSaved { get; set; }
    [Parameter] public EventCallback OnCancelled { get; set; }

    private int? _editingId;
    private string _name = "";
    private TerminalRole _role = TerminalRole.Caller;
    private int? _unitNo;
    private string _pin = "";
    private bool _isActive = true;
    private string? _error;

    public void OpenForCreate()
    {
        _editingId = null;
        _name = "";
        _role = TerminalRole.Caller;
        _unitNo = null;
        _pin = "0000";
        _isActive = true;
        _error = null;
    }

    public void OpenForEdit(TerminalDto terminal)
    {
        _editingId = terminal.Id;
        _name = terminal.Name;
        _role = terminal.Role;
        _unitNo = terminal.UnitNo;
        _pin = "";
        _isActive = terminal.IsActive;
        _error = null;
    }

    private async Task Save()
    {
        _error = null;

        if (_editingId is null)
        {
            var result = await Api.CreateTerminalAsync(new CreateTerminalRequest
            {
                Name = _name,
                Role = _role,
                UnitNo = _role == TerminalRole.Caller ? _unitNo : null,
                Pin = string.IsNullOrWhiteSpace(_pin) ? "0000" : _pin
            });
            if (!result.Success) { _error = result.ErrorCode is not null ? Loc.Format(result.ErrorCode, result.ErrorArgs ?? []) : Loc["CannotCreateTerminal"]; return; }
            await OnSaved.InvokeAsync();
        }
        else
        {
            var result = await Api.UpdateTerminalAsync(_editingId.Value, new UpdateTerminalRequest
            {
                Name = _name,
                UnitNo = _role == TerminalRole.Caller ? _unitNo : null,
                IsActive = _isActive,
                NewPin = string.IsNullOrWhiteSpace(_pin) ? null : _pin
            });
            if (!result.Success) { _error = result.ErrorCode is not null ? Loc.Format(result.ErrorCode, result.ErrorArgs ?? []) : Loc["CannotSaveTerminal"]; return; }
            await OnSaved.InvokeAsync();
        }
    }

    private async Task Cancel() => await OnCancelled.InvokeAsync();
}
