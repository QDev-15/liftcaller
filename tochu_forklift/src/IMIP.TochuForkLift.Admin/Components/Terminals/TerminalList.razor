@* Table of Caller/Receiver terminals — plan.md §4.4. *@
@inject Localizer Loc

<div class="table-wrap">
    <table class="admin-table">
        <thead>
            <tr><th>@Loc["ColName"]</th><th>@Loc["ColRole"]</th><th>@Loc["ColUnitNo"]</th><th>@Loc["ColStatus"]</th><th>@Loc["ColConnection"]</th><th></th></tr>
        </thead>
        <tbody>
            @if (Terminals.Count == 0)
            {
                <tr><td colspan="6" style="text-align:center; color:var(--muted);">@Loc["NoTerminals"]</td></tr>
            }
            else
            {
                @foreach (var t in Terminals)
                {
                    <tr>
                        <td>@t.Name</td>
                        <td>@(t.Role == TerminalRole.Caller ? Loc["RoleCaller"] : Loc["RoleReceiver"])</td>
                        <td class="mono">@(t.UnitNo?.ToString() ?? "—")</td>
                        <td>
                            @if (t.IsActive)
                            {
                                <span class="status-chip on">@Loc["Active"]</span>
                            }
                            else
                            {
                                <span class="status-chip off">@Loc["Inactive"]</span>
                            }
                        </td>
                        <td>
                            @if (t.IsOnline)
                            {
                                <span class="status-chip on">@Loc["Online"]</span>
                            }
                            else
                            {
                                <span class="status-chip off">@Loc["Offline"]</span>
                            }
                        </td>
                        <td><button type="button" class="btn btn-sm" @onclick="() => OnEdit.InvokeAsync(t)">@Loc["Edit"]</button></td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>

@code {
    [Parameter, EditorRequired] public List<TerminalDto> Terminals { get; set; } = [];
    [Parameter] public EventCallback<TerminalDto> OnEdit { get; set; }
}
