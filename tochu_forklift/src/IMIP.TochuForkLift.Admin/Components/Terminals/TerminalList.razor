@* Table of Caller/Receiver terminals — plan.md §4.4. *@

<div class="table-wrap">
    <table>
        <thead>
            <tr><th>Tên</th><th>Vai trò</th><th>Số máy</th><th>Trạng thái</th><th></th></tr>
        </thead>
        <tbody>
            @if (Terminals.Count == 0)
            {
                <tr><td colspan="5" style="text-align:center; color:var(--muted);">Chưa có Terminal nào.</td></tr>
            }
            else
            {
                @foreach (var t in Terminals)
                {
                    <tr>
                        <td>@t.Name</td>
                        <td>@(t.Role == TerminalRole.Caller ? "Caller" : "Receiver")</td>
                        <td>@(t.UnitNo?.ToString() ?? "—")</td>
                        <td>
                            @if (t.IsActive)
                            {
                                <span class="badge badge-on">Active</span>
                            }
                            else
                            {
                                <span class="badge badge-off">Inactive</span>
                            }
                        </td>
                        <td><button type="button" class="btn btn-sm" @onclick="() => OnEdit.InvokeAsync(t)">Sửa</button></td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>

@code {
    [Parameter, EditorRequired] public List<TerminalDto> Terminals { get; set; } = [];
    [Parameter] public EventCallback<TerminalDto> OnEdit { get; set; }
}
