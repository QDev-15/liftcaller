@page "/terminals"
@attribute [Authorize]
@rendermode InteractiveServer
@implements IDisposable
@inject ForkLiftApiClient Api
@inject AdminStateSyncService Sync
@inject Localizer Loc

<PageTitle>@Loc["AdminTerminalsTitle"] — @Loc["AdminAppTitle"]</PageTitle>

<h1>@Loc["AdminTerminalsTitle"]</h1>

@if (_loadError is not null)
{
    <div class="conn-banner">@_loadError</div>
}

<section class="admin-section">
    <div class="admin-section-head">
        <h3>@Loc["TerminalsSection"]</h3>
        <button type="button" class="btn btn-primary" @onclick="OpenCreate">@Loc["CreateTerminal"]</button>
    </div>
    <TerminalList Terminals="_terminals" OnEdit="OpenEdit" />
</section>

<TerminalFormModal @ref="_modal" Show="_showModal" OnSaved="OnSaved" OnCancelled="CloseModal" />

@code {
    private List<TerminalDto> _terminals = [];
    private TerminalFormModal? _modal;
    private bool _showModal;
    private string? _loadError;

    protected override async Task OnInitializedAsync()
    {
        await Sync.InitializeAsync();
        Sync.Updated += OnSyncUpdated;
        await ReloadAsync();
    }

    // Online/offline isn't part of the pushed StateSnapshotDto (it's per-terminal admin metadata,
    // not factory-floor state) — re-pull the terminal list whenever something changes elsewhere
    // (SignalR push, or the poll loop's safety-net tick) so the Connection column stays live.
    private void OnSyncUpdated() => InvokeAsync(async () =>
    {
        await ReloadAsync();
        StateHasChanged();
    });

    private async Task ReloadAsync()
    {
        try
        {
            _terminals = await Api.GetTerminalsAsync();
            _loadError = null;
        }
        catch
        {
            _loadError = Loc["AdminApiUnreachable"];
        }
    }

    private void OpenCreate()
    {
        _modal?.OpenForCreate();
        _showModal = true;
    }

    private void OpenEdit(TerminalDto terminal)
    {
        _modal?.OpenForEdit(terminal);
        _showModal = true;
    }

    private async Task OnSaved()
    {
        _showModal = false;
        await ReloadAsync();
    }

    private void CloseModal() => _showModal = false;

    public void Dispose() => Sync.Updated -= OnSyncUpdated;
}
