@inherits LayoutComponentBase

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row">
            <div class="top-row-right">
                @* Plain onclick (not @onclick): MainLayout isn't inside an interactive render
                   boundary — see the logout form below for the same reason — so this toggles the
                   theme via a normal DOM event, not a Blazor circuit. *@
                <button type="button" class="theme-toggle" title="Đổi giao diện sáng/tối"
                        onclick="window.adminTheme.toggle()">
                    <span class="icon-sun">@Icons.Sun</span>
                    <span class="icon-moon">@Icons.Moon</span>
                </button>
                <AuthorizeView>
                    <Authorized>
                        <span class="top-row-user">@context.User.Identity?.Name</span>
                        <form method="post" action="/account/logout">
                            <button type="submit" class="btn btn-sm btn-outline-secondary">Đăng xuất</button>
                        </form>
                    </Authorized>
                </AuthorizeView>
            </div>
        </div>

        <article class="content">
            @Body
        </article>
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>
