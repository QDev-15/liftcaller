@inject Localizer Loc

<a class="navbar-brand" href="">@Icons.Lift<span>@Loc["AdminAppTitle"]</span></a>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="nav flex-column">
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">@Loc["AdminDashboardTitle"]</NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="terminals">@Loc["AdminTerminalsTitle"]</NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="history">@Loc["AdminHistoryTitle"]</NavLink>
        </div>
    </nav>
</div>
